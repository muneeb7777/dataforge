# Postgres
POSTGRES_USER=dataforge
POSTGRES_PASSWORD=dataforge
POSTGRES_DB=dataforge

# Backend (used when running outside docker compose too)
DATABASE_URL=postgresql+asyncpg://dataforge:dataforge@localhost:5432/dataforge
SYNC_DATABASE_URL=postgresql+psycopg://dataforge:dataforge@localhost:5432/dataforge
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-production-please
JWT_LIFETIME_SECONDS=86400

# External API
FRED_API_KEY=your-fred-api-key-here

# Misc
ENVIRONMENT=development
UPLOAD_DIR=/app/uploads
DUCKDB_DIR=/app/duckdb_data
MAX_UPLOAD_SIZE_MB=500
